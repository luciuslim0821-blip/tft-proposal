<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Proposal Generator · The Freedom Tribe</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  body { background:#0D0D0D; color:#E8E0D0; font-family:'Segoe UI',Arial,sans-serif; min-height:100vh; padding:32px 20px; }
  .container { max-width:640px; margin:0 auto; }
  .header { text-align:center; margin-bottom:32px; }
  .header h1 { font-size:24px; color:#D4A843; font-weight:700; letter-spacing:2px; margin-bottom:6px; }
  .header p { font-size:13px; color:#706050; }
  .lang-tabs { display:flex; gap:8px; margin-bottom:20px; }
  .lang-tab { flex:1; padding:10px; text-align:center; border:1px solid #2A2A2A; background:#111; color:#706050; cursor:pointer; font-size:13px; border-radius:4px; transition:all 0.2s; }
  .lang-tab.active { border-color:#D4A843; background:#1A1608; color:#D4A843; font-weight:600; }
  .card { background:#111; border:1px solid #2A2A2A; border-radius:8px; padding:20px; margin-bottom:16px; }
  .card h3 { font-size:10px; color:#C8A96E; letter-spacing:3px; text-transform:uppercase; margin-bottom:14px; }
  .form-row { margin-bottom:13px; }
  .form-row label { display:block; font-size:12px; color:#908070; margin-bottom:5px; }
  .form-row input, .form-row select { width:100%; background:#0D0D0D; border:1px solid #2A2A2A; color:#E8E0D0; padding:10px 12px; border-radius:4px; font-size:13px; font-family:inherit; }
  .form-row input:focus, .form-row select:focus { outline:none; border-color:#D4A843; }
  .form-row select option { background:#111; }
  .grid2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .exp-section { display:none; }
  .exp-section.show { display:block; }
  .generate-btn { width:100%; padding:14px; background:#D4A843; color:#0D0D0D; border:none; border-radius:4px; font-size:15px; font-weight:700; cursor:pointer; letter-spacing:2px; margin-top:4px; transition:opacity 0.2s; }
  .generate-btn:hover { opacity:0.85; }
  .generate-btn:disabled { opacity:0.4; cursor:not-allowed; }
  .status { margin-top:16px; padding:14px; border-radius:6px; font-size:13px; display:none; }
  .status.loading { background:#161410; border:1px solid #3A2E10; color:#C8A96E; display:block; }
  .status.success { background:#0E1410; border:1px solid #1E4020; color:#6EA880; display:block; }
  .status.error { background:#140E0E; border:1px solid #3A1A1A; color:#C06060; display:block; }
  .spinner { display:inline-block; width:14px; height:14px; border:2px solid #3A2E10; border-top-color:#D4A843; border-radius:50%; animation:spin 0.8s linear infinite; margin-right:8px; vertical-align:middle; }
  @keyframes spin { to { transform:rotate(360deg); } }
  .target-pills { display:flex; gap:8px; }
  .target-pill { flex:1; padding:10px; text-align:center; border:1px solid #2A2A2A; background:#0D0D0D; color:#706050; cursor:pointer; font-size:13px; border-radius:4px; transition:all 0.2s; }
  .target-pill.active { border-color:#D4A843; background:#1A1608; color:#D4A843; font-weight:600; }
</style>
</head>
<body>
<div class="container">
  <div class="header">
    <h1>Proposal Generator</h1>
    <p id="header-sub">填写你的信息，一键生成专业 Proposal（PPTX 格式）</p>
  </div>

  <div class="lang-tabs">
    <div class="lang-tab active" onclick="setLang('zh')">🇨🇳 中文版</div>
    <div class="lang-tab" onclick="setLang('en')">🇬🇧 English</div>
  </div>

  <div class="card">
    <h3 id="section1-title">你的信息</h3>
    <div class="grid2">
      <div class="form-row">
        <label id="label-name">名字 / 公司名</label>
        <input type="text" id="input-name" placeholder="e.g. Ahmad Property Services">
      </div>
      <div class="form-row">
        <label id="label-contact">WhatsApp</label>
        <input type="text" id="input-contact" placeholder="e.g. 011-1234 5678">
      </div>
    </div>
    <div class="form-row">
      <label id="label-area">目标地区</label>
      <input type="text" id="input-area" placeholder="e.g. Batu Kawan, Penang">
    </div>
  </div>

  <div class="card">
    <h3 id="section2-title">合作对象</h3>
    <div class="form-row">
      <label id="label-target">你要发给谁？</label>
      <div class="target-pills">
        <div class="target-pill active" id="pill-op" onclick="setTarget('operator')">🏢 Operator</div>
        <div class="target-pill" id="pill-ow" onclick="setTarget('owner')" id="pill-owner-label">🏠 <span id="pill-owner-text">屋主</span></div>
      </div>
    </div>
  </div>

  <div class="card">
    <h3 id="section3-title">你的经验 / 成绩</h3>
    <div class="form-row">
      <label id="label-exp-type">选择你的情况</label>
      <select id="select-exp" onchange="setExpType(this.value)">
        <option value="A" id="opt-A">我已有出租成绩</option>
        <option value="B" id="opt-B">我手上有潜在租客名单</option>
        <option value="C" id="opt-C">我是新手，专注执行</option>
      </select>
    </div>

    <div class="exp-section show" id="exp-A">
      <div class="grid2">
        <div class="form-row">
          <label id="label-units">成功出租间数</label>
          <input type="number" id="input-units" placeholder="e.g. 8" min="1">
        </div>
        <div class="form-row">
          <label id="label-days">最快几天出租</label>
          <input type="number" id="input-days" placeholder="e.g. 7" min="1">
        </div>
      </div>
    </div>

    <div class="exp-section" id="exp-B">
      <div class="form-row">
        <label id="label-leads">潜在租客人数</label>
        <input type="number" id="input-leads" placeholder="e.g. 25" min="1">
      </div>
    </div>
  </div>

  <button class="generate-btn" id="gen-btn" onclick="generate()">✦ <span id="btn-text">生成我的 Proposal</span></button>

  <div class="status" id="status-box"></div>
</div>

<script>
let currentLang = 'zh';
let currentTarget = 'operator';
let currentExpType = 'A';

function setLang(lang) {
  currentLang = lang;
  document.querySelectorAll('.lang-tab').forEach((t,i) => t.classList.toggle('active', (i===0&&lang==='zh')||(i===1&&lang==='en')));
  if (lang==='zh') {
    document.getElementById('header-sub').textContent = '填写你的信息，一键生成专业 Proposal（PPTX 格式）';
    document.getElementById('section1-title').textContent = '你的信息';
    document.getElementById('label-name').textContent = '名字 / 公司名';
    document.getElementById('input-name').placeholder = 'e.g. Ahmad Property Services';
    document.getElementById('label-contact').textContent = 'WhatsApp';
    document.getElementById('label-area').textContent = '目标地区';
    document.getElementById('input-area').placeholder = 'e.g. Batu Kawan, Penang';
    document.getElementById('section2-title').textContent = '合作对象';
    document.getElementById('label-target').textContent = '你要发给谁？';
    document.getElementById('pill-owner-text').textContent = '屋主';
    document.getElementById('section3-title').textContent = '你的经验 / 成绩';
    document.getElementById('label-exp-type').textContent = '选择你的情况';
    document.getElementById('opt-A').textContent = '我已有出租成绩';
    document.getElementById('opt-B').textContent = '我手上有潜在租客名单';
    document.getElementById('opt-C').textContent = '我是新手，专注执行';
    document.getElementById('label-units').textContent = '成功出租间数';
    document.getElementById('input-units').placeholder = 'e.g. 8';
    document.getElementById('label-days').textContent = '最快几天出租';
    document.getElementById('input-days').placeholder = 'e.g. 7';
    document.getElementById('label-leads').textContent = '潜在租客人数';
    document.getElementById('input-leads').placeholder = 'e.g. 25';
    document.getElementById('btn-text').textContent = '生成我的 Proposal';
  } else {
    document.getElementById('header-sub').textContent = 'Fill in your info to generate a professional Proposal (PPTX format)';
    document.getElementById('section1-title').textContent = 'Your Information';
    document.getElementById('label-name').textContent = 'Name / Company Name';
    document.getElementById('input-name').placeholder = 'e.g. Ahmad Property Services';
    document.getElementById('label-contact').textContent = 'WhatsApp';
    document.getElementById('label-area').textContent = 'Target Area';
    document.getElementById('input-area').placeholder = 'e.g. Batu Kawan, Penang';
    document.getElementById('section2-title').textContent = 'Target Recipient';
    document.getElementById('label-target').textContent = 'Who are you sending this to?';
    document.getElementById('pill-owner-text').textContent = 'Landlord';
    document.getElementById('section3-title').textContent = 'Your Experience';
    document.getElementById('label-exp-type').textContent = 'Select your situation';
    document.getElementById('opt-A').textContent = 'I have rental success records';
    document.getElementById('opt-B').textContent = 'I have a list of potential tenants';
    document.getElementById('opt-C').textContent = "I'm new, but committed";
    document.getElementById('label-units').textContent = 'Rooms successfully rented';
    document.getElementById('input-units').placeholder = 'e.g. 8';
    document.getElementById('label-days').textContent = 'Fastest days to rent out';
    document.getElementById('input-days').placeholder = 'e.g. 7';
    document.getElementById('label-leads').textContent = 'Number of potential tenants';
    document.getElementById('input-leads').placeholder = 'e.g. 25';
    document.getElementById('btn-text').textContent = 'Generate My Proposal';
  }
}

function setTarget(t) {
  currentTarget = t;
  document.getElementById('pill-op').classList.toggle('active', t==='operator');
  document.getElementById('pill-ow').classList.toggle('active', t==='owner');
}

function setExpType(v) {
  currentExpType = v;
  document.querySelectorAll('.exp-section').forEach(el => el.classList.remove('show'));
  if (v !== 'C') document.getElementById('exp-'+v).classList.add('show');
}

async function generate() {
  const name = document.getElementById('input-name').value.trim();
  const contact = document.getElementById('input-contact').value.trim();
  const area = document.getElementById('input-area').value.trim();

  if (!name || !contact || !area) {
    showStatus('error', currentLang==='zh' ? '请填写名字、WhatsApp 和目标地区' : 'Please fill in name, WhatsApp and target area');
    return;
  }

  const payload = {
    name, contact, area,
    target: currentTarget,
    exp_type: currentExpType,
    exp_units: document.getElementById('input-units').value,
    exp_days: document.getElementById('input-days').value,
    exp_leads: document.getElementById('input-leads').value,
    lang: currentLang
  };

  document.getElementById('gen-btn').disabled = true;
  showStatus('loading', currentLang==='zh' ? '<span class="spinner"></span>正在生成你的专属 Proposal...' : '<span class="spinner"></span>Generating your proposal...');

  try {
    const res = await fetch('/api/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    if (!res.ok) throw new Error('Generation failed');

    const blob = await res.blob();
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `Proposal_${name.replace(/[^a-zA-Z0-9]/g,'_')}.pptx`;
    a.click();
    URL.revokeObjectURL(url);

    showStatus('success', currentLang==='zh' ? '✔ Proposal 已生成！正在下载...' : '✔ Proposal generated! Downloading...');
  } catch (err) {
    showStatus('error', currentLang==='zh' ? '生成失败，请重试' : 'Generation failed, please try again');
  }

  document.getElementById('gen-btn').disabled = false;
}

function showStatus(type, msg) {
  const box = document.getElementById('status-box');
  box.className = 'status ' + type;
  box.innerHTML = msg;
}
</script>
</body>
</html>
